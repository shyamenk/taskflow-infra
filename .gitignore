# Terraform local working files
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Plan output and variable files that may hold secrets
*.tfplan
tfplan
*.auto.tfvars
secrets.tfvars

# Overrides are local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Editor and OS
.idea/
.vscode/
.DS_Store

# Credentials and keys: never commit
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.aws/
credentials
kubeconfig*
*.kubeconfig

# Variable files can hold secrets; commit only *.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example
